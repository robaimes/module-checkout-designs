{
    "name": "aimes/module-checkout-designs",
    "type": "magento2-module",
    "description": "Swap checkout layouts via system configuration, or conditions",
    "license": [
        "GPL-3.0-or-later"
    ],
    "authors": [
        {
            "name": "Rob Aimes",
            "email": "rob@aimes.dev",
            "homepage": "https://aimes.dev"
        }
    ],
    "require": {
        "magento/module-checkout": "^100.3 || ^100.4"
    },
    "suggest": {
        "aimes/module-checkout-designs-example": "Provides code examples to utilise this package"
    },
    "autoload": {
        "psr-4": {
            "Aimes\\CheckoutDesigns\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
